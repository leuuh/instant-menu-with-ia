# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Provedor de LLM: troque esta linha para mudar de provedor.
LLM_PROVIDER=gemini
# Modelo (opcional). Vazio = padrão do provedor (gemini-3.8-flash).
LLM_MODEL=

# Chave da API do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Itens com confiança abaixo deste valor vão para revisão humana.
LIMIAR_CONFIANCA=0.7
